# dependencies
/node_modules
/.npm

# next.js build output
/.next/
/out/
next-env.d.ts
*.tsbuildinfo

# generated on every build: scripts/copy-flags.mjs, scripts/build-images.mjs,
# scripts/pack-sequence.mjs
/public/flags/
/public/_img/
/public/sequence/packs/

# Amplify deployment bundle, made by scripts/package-amplify.mjs
/.amplify-hosting/

# Vercel CLI project link and `vercel build` output
/.vercel/

# raw frame sequences — one-time build inputs (see README)
/assets/sequence/raw-700/
/assets/sequence/raw-360/

# local env files
.env*.local
.env
.env.production

# python
__pycache__/

# misc
.DS_Store
*.pem
npm-debug.log*
